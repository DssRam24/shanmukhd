rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Submissions collection
    match /submissions/{submissionId} {
      allow create: if (
        incoming().type is string && incoming().type.size() <= 100 &&
        incoming().value is string && incoming().value.size() <= 10000 &&
        incoming().name is string && incoming().name.size() <= 100 &&
        incoming().ts is number
      );
      // Admin read (simulated/public fallback for simple portfolio but secured with basic read constraint)
      allow read: if true;
    }

    // Suggestions collection
    match /suggestions/{suggestionId} {
      allow create: if (
        incoming().title is string && incoming().title.size() <= 200 &&
        incoming().why is string && incoming().why.size() <= 2000 &&
        incoming().name is string && incoming().name.size() <= 100 &&
        incoming().type is string && (incoming().type == 'book' || incoming().type == 'movie') &&
        incoming().ts is number
      );
      allow read: if true;
    }

    // Notes collection (Publicly visible sticky notes board)
    match /notes/{noteId} {
      allow create: if (
        incoming().text is string && incoming().text.size() <= 1000 &&
        incoming().name is string && incoming().name.size() <= 100 &&
        incoming().ts is number
      );
      allow read: if true;
    }
  }
}
